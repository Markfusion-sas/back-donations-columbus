# ==========================================================
#  Variables de entorno del BACKEND
#  Copia este archivo como ".env" y completa los valores.
# ==========================================================

NODE_ENV=development
PORT=3000
# Puede llevar varios orígenes separados por coma (p. ej. producción,http://localhost:5173)
FRONTEND_URL=https://fundaciontcs.columbus.edu.co

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Redis (cobros recurrentes)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://...

# Wompi
SECRET_EVENT=
INTEGRITY_SECRET=
WOMPI_PRIVATE_KEY=
WOMPI_PUBLIC_KEY=
WOMPI_API_URL=https://api.wompi.co/v1

# Correos (Resend)
RESEND_API_KEY=
RESEND_EMAIL=notificaciones@tu-dominio-verificado.com

# Directorio comercial (emprendimientos)
# Correo que recibe la alerta cuando hay un emprendimiento por aprobar
ADMIN_EMAIL=fundaciontcs@columbus.edu.co
# (Opcional) Clave para aprobar/rechazar desde el panel admin. Si se define,
# el frontend debe enviarla en VITE_ADMIN_API_KEY.
ADMIN_API_KEY=
# Carpeta donde se guardan logos y fotos (relativa a la raíz del backend)
UPLOADS_DIR=uploads
# URL pública del backend para construir los enlaces de las imágenes.
# Si no se define, se usa el host de la petición.
PUBLIC_URL=https://fundaciontcs.columbus.edu.co

# Base de datos del colegio (SQL Server) para validar que quien registra una marca
# pertenezca a la comunidad TCS (familias, estudiantes y staff). Son los mismos datos
# de conexión que usa TCS Run (FastAPI_TCS/.env: MSSQL_HOST, MSSQL_USER, ...).
# Si MSSQL_HOST queda vacío la validación se desactiva y los registros quedan "pendiente".
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DB=

# Correo saliente por SMTP desde el buzón de la Fundación (Google Workspace).
# Tiene prioridad sobre Resend. Google exige una CONTRASEÑA DE APLICACIÓN
# (myaccount.google.com > Seguridad > Contraseñas de aplicaciones), no la normal.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=fundaciontcs@columbus.edu.co
MAIL_PASSWORD=
MAIL_FROM=

# Base de datos del sitio. Producción: SQL Server del colegio (como los demás eventos).
# DB_DIALECT=mssql, DB_HOST=10.90.11.15, DB_NAME=EventosTCS (pruebas: EventosTCS_dev),
# DB_SCHEMA=fundacion. Sin DB_DIALECT se usa Postgres (desarrollo local).
DB_DIALECT=
DB_SCHEMA=

# Contraseña del panel /admin (obligatoria en producción). Se verifica en el
# backend y entrega una sesión de 8 horas. Cambiarla cierra todas las sesiones.
ADMIN_PASSWORD=
