# ==========================================================
#  Variables de entorno del BACKEND
#  Copia este archivo como ".env" y completa los valores.
# ==========================================================

NODE_ENV=development
PORT=3000
FRONTEND_URL=https://fundaciontcs.columbus.edu.co

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Redis (cobros recurrentes)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://...

# Wompi
SECRET_EVENT=
INTEGRITY_SECRET=
WOMPI_PRIVATE_KEY=
WOMPI_PUBLIC_KEY=
WOMPI_API_URL=https://api.wompi.co/v1

# Correos (Resend)
RESEND_API_KEY=
RESEND_EMAIL=notificaciones@tu-dominio-verificado.com

# Directorio comercial (emprendimientos)
# Correo que recibe la alerta cuando hay un emprendimiento por aprobar
ADMIN_EMAIL=fundaciontcs@columbus.edu.co
# (Opcional) Clave para aprobar/rechazar desde el panel admin. Si se define,
# el frontend debe enviarla en VITE_ADMIN_API_KEY.
ADMIN_API_KEY=
# Carpeta donde se guardan logos y fotos (relativa a la raíz del backend)
UPLOADS_DIR=uploads
# URL pública del backend para construir los enlaces de las imágenes.
# Si no se define, se usa el host de la petición.
PUBLIC_URL=https://fundaciontcs.columbus.edu.co
