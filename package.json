{
  "name": "pasarela-wompi",
  "version": "1.0.0",
  "description": "Pasarela de pagos con Wompi y PostgreSQL",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/app.js",
    "test": "node --import ./test/setupTest.js --test",
    "test:watch": "node --run test -- --watch",
    "test:coverage": "npx c8 node --run test",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "express": "^5.1.0",
    "joi": "^18.0.0",
    "pg": "^8.16.3",
    "resend": "^6.9.3",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "c8": "^10.1.3",
    "eslint": "^9.32.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.4",
    "globals": "^16.3.0",
    "sequelize-test-helpers": "^1.4.3"
  },
  "c8": {
    "exclude": [
      "*.config.*",
      "**/index.js",
      "src/app.js",
      "src/config/**",
      "src/utils/logger.util.js",
      "src/middlewares/cors.middleware.js",
      "src/routers/**"
    ],
    "include": [
      "src/",
      "lib/"
    ],
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "all": true,
    "check-coverage": true,
    "branches": 0,
    "functions": 0,
    "lines": 0,
    "statements": 0
  },
  "imports": {
    "#*": "./src/*.js",
    "#test/*": "./test/*.js"
  }
}
